# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Current multimodal Gemma tag in Ollama library (e.g. gemma3:4b, gemma3:12b)
GEMMA_VISION_MODEL=gemma3:4b
# Fallback to simulated extraction when Ollama daemon is unreachable
OLLAMA_MOCK_FALLBACK=true

# TabPFN Configuration
# Mode: LOCAL (on-device CPU/GPU, zero data egress) or CLIENT (cloud API, numeric columns only)
TABPFN_MODE=LOCAL
ENABLE_TABPFN_API=false
TABPFN_TOKEN=

# Services
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./ledgerlens.db
OBSERVABILITY_LOG_FILE=observability.json
